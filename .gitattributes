# Normalize line endings on commit; check out with the platform's native endings.
* text=auto

# Windows-only tooling: keep CRLF in the working tree so PowerShell / batch behave.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Plain-text project files: LF is fine.
*.md          text eol=lf
*.gitignore   text eol=lf
*.gitattributes text eol=lf
LICENSE       text eol=lf

# Binary assets: never touch them.
*.png binary
*.ico binary
*.exe binary
*.jpg binary
*.jpeg binary
*.gif binary
