<Application x:Class="Poni.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Poni.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Order matters: the colour palette (inserted first by ThemeService) and the
                 string table (added last by LocalizationService) are swapped at runtime. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <infra:EnumToBoolConverter x:Key="EnumToBool"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <infra:VisibilityConverter x:Key="Visible"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
