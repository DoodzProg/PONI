<UserControl x:Class="Poni.Views.Rj45Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Poni.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,36,40,90">

            <!-- ============================================ header -->
            <DockPanel Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom"
                        AutomationProperties.Name="{DynamicResource Str.Common.Refresh}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="13" Height="13" Margin="0,0,6,0">
                            <c:Icon Data="{StaticResource Icon.Refresh}" Width="13" Height="13" StrokeThickness="2.2"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Visibility="{Binding IsRefreshing, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
                            <c:Icon Style="{StaticResource Spinner}" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}"
                                    Visibility="{Binding IsRefreshing, Converter={StaticResource Visible}}"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str.Common.Refresh}"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Rj45.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Rj45.Subtitle}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <!-- VM adapters pointing to a deleted switch: those VMs cannot start -->
            <Border CornerRadius="16" Padding="18,16" Margin="0,0,0,24" Background="{DynamicResource WarningBackgroundBrush}"
                    Visibility="{Binding HasDangling, Converter={StaticResource Visible}}">
                <DockPanel>
                    <c:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Warning}" Width="20" Height="20" StrokeThickness="2"
                            Margin="0,1,14,0" VerticalAlignment="Top" Foreground="{DynamicResource WarningBrush}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallPrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                            Content="{DynamicResource Str.Rj45.Repair}" Command="{Binding RepairCommand}"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Rj45.DanglingTitle}" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource Str.Rj45.DanglingText}" FontSize="12.5" Margin="0,4,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DanglingList}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hyper-V could not be read -->
            <ContentControl Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,24"
                            Visibility="{Binding HasState, Converter={StaticResource Visible}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Rj45.Reading}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ReadError}" Style="{StaticResource RowCaption}"
                               Visibility="{Binding ReadError, Converter={StaticResource Visible}}"/>
                </StackPanel>
            </ContentControl>

            <!-- ============================================ hero: where the port points -->
            <ContentControl Style="{StaticResource Card}" Padding="30,28" Margin="0,0,0,30"
                            Visibility="{Binding HasState, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- diagram: port -> destination -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Width="120">
                            <Border Width="88" Height="88" CornerRadius="24" Background="{DynamicResource FieldBrush}">
                                <c:Icon Data="{StaticResource Icon.Rj45}" Width="40" Height="40" StrokeThickness="1.5"/>
                            </Border>
                            <TextBlock Text="{Binding PhysicalName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PhysicalDescription}" FontSize="11.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding PhysicalDescription}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,34">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                            <Border Width="96" Height="3" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                            <c:Icon Data="M8,5 L15,12 L8,19" Width="14" Height="14" StrokeThickness="3" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Width="120">
                            <Border Width="88" Height="88" CornerRadius="24" Background="{DynamicResource AccentTintBrush}">
                                <c:Icon Width="40" Height="40" StrokeThickness="1.5" Foreground="{DynamicResource AccentBrush}">
                                    <c:Icon.Style>
                                        <Style TargetType="c:Icon" BasedOn="{StaticResource {x:Type c:Icon}}">
                                            <Setter Property="Data" Value="{StaticResource Icon.Monitor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mode}" Value="Host">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Laptop}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Mode}" Value="Orphan">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Warning}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:Icon.Style>
                                </c:Icon>
                            </Border>
                            <TextBlock Text="{Binding TargetName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetName}"/>
                            <TextBlock Text="{Binding TargetSub}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" Margin="34,0"/>

                    <!-- text + actions -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" Padding="8,3,10,3" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnomaly}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center"
                                         Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                                <TextBlock Text="{Binding PillText}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding HeroTitle}" FontFamily="{StaticResource FontDisplay}" FontSize="23" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding HeroText}" FontSize="13.5" LineHeight="20" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Height="34" c:Ui.CornerRadius="17" FontSize="13.5"
                                    Content="{DynamicResource Str.Rj45.GiveToWindows}" Command="{Binding ReturnToHostCommand}"
                                    Visibility="{Binding CanChangePhysical, Converter={StaticResource Visible}, ConverterParameter=invert}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource LinkButton}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                    Content="{DynamicResource Str.Rj45.ChangePhysical}" Command="{Binding ChangePhysicalCommand}"
                                    IsEnabled="{Binding CanChangePhysical}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{DynamicResource Str.Rj45.ChangeOnlyOnHost}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- ============================================ destinations -->
            <DockPanel Margin="0,0,0,12" Visibility="{Binding HasState, Converter={StaticResource Visible}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Icon Data="{StaticResource Icon.Info}" Width="14" Height="14" StrokeThickness="2" Margin="0,0,6,0"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{DynamicResource Str.Rj45.OneAtATime}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource Str.Rj45.Destinations}" FontSize="15" FontWeight="SemiBold"/>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Destinations}" Margin="0,0,-14,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,14,14">
                            <ContentControl Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" VerticalAlignment="Top" Padding="9,3" CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <c:Icon Width="20" Height="20">
                                                <c:Icon.Style>
                                                    <Style TargetType="c:Icon" BasedOn="{StaticResource {x:Type c:Icon}}">
                                                        <Setter Property="Data" Value="{StaticResource Icon.Monitor}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHost}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource Icon.Laptop}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </c:Icon.Style>
                                            </c:Icon>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="12.5" Margin="0,2,0,14" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button Height="32" c:Ui.CornerRadius="16" FontSize="13" Content="{Binding ButtonText}"
                                            Command="{Binding SwitchCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </ContentControl>
                            <!-- accent ring on the current destination -->
                            <Border CornerRadius="18" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
