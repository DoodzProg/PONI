<UserControl x:Class="Poni.Views.Dialogs.PhysicalAdapterDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Str.Rj45.PhysicalTitle}" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{DynamicResource Str.Rj45.PhysicalHint}" FontSize="12.5" Margin="0,6,0,18" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Style="{StaticResource ChoiceRow}" GroupName="Physical" IsChecked="{Binding IsSelected}"
                                 IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str.Common.Cancel}" Command="{Binding CancelCommand}"
                    IsCancel="True" Margin="0,0,10,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.Common.Save}" Command="{Binding ConfirmCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
