<UserControl x:Class="Poni.Views.Dialogs.LogViewerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Poni.Controls">
    <DockPanel>
        <!-- ============================================ header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentedHost}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="LogFilter" Content="{DynamicResource Str.Log.All}"
                                 IsChecked="{Binding ShowAll}"/>
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="LogFilter" Content="{DynamicResource Str.Log.Problems}"
                                 IsChecked="{Binding ProblemsOnly}"/>
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="{DynamicResource Str.Log.Title}" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- ============================================ day navigation -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.ChevronLeft}"
                    Command="{Binding OlderCommand}" ToolTip="{DynamicResource Str.Log.Older}"
                    AutomationProperties.Name="{DynamicResource Str.Log.Older}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="{StaticResource Icon.ChevronRight}" Margin="6,0,0,0"
                    Command="{Binding NewerCommand}" ToolTip="{DynamicResource Str.Log.Newer}"
                    AutomationProperties.Name="{DynamicResource Str.Log.Newer}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Tag="{StaticResource Icon.Refresh}"
                    Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Str.Log.Refresh}"
                    AutomationProperties.Name="{DynamicResource Str.Log.Refresh}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding DayLabel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>

        <!-- ============================================ buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Folder}" Width="15" Height="15" StrokeThickness="2" Margin="0,0,7,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Str.Log.OpenFolder}"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.Common.Close}"
                    Command="{Binding CancelCommand}" IsCancel="True" IsDefault="True"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding CopyCommand}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Copy}" Width="15" Height="15" StrokeThickness="2" Margin="0,0,7,0"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CopyText}"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- ============================================ entries (virtualized: a day can hold thousands of lines) -->
        <Border CornerRadius="14" Background="{DynamicResource FieldBrush}" Height="440" Padding="4">
            <Grid>
                <TextBlock Text="{Binding EmptyText}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"/>
                <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="{DynamicResource Str.Log.Title}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Message}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="9" Padding="10,6" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,1,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Border x:Name="pill" Grid.Column="1" Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="Transparent">
                                    <TextBlock x:Name="level" Text="{Binding LevelText}" Style="{StaticResource PillText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource FontMono}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,4,0,2" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding HasDetail, Converter={StaticResource Visible}}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                                    <Setter TargetName="level" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/>
                                    <Setter TargetName="level" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
