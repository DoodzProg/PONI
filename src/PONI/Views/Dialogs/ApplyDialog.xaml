<UserControl x:Class="Poni.Views.Dialogs.ApplyDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Poni.Controls">
    <StackPanel>
        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Summary}" FontSize="12.5" Margin="0,4,0,18" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- Target kind -->
        <Border Style="{StaticResource SegmentedHost}" HorizontalAlignment="Stretch" Padding="3" CornerRadius="11">
            <UniformGrid Columns="2">
                <RadioButton Style="{StaticResource SegmentItem}" GroupName="ApplyKind" Height="32" FontSize="13.5"
                             IsChecked="{Binding IsHostTab}" Content="{DynamicResource Str.Apply.ThisComputer}"/>
                <RadioButton Style="{StaticResource SegmentItem}" GroupName="ApplyKind" Height="32" FontSize="13.5"
                             IsChecked="{Binding IsVmTab}" IsEnabled="{Binding VmTabAvailable}"
                             Content="{DynamicResource Str.Apply.VirtualMachine}"
                             ToolTipService.ShowOnDisabled="True" ToolTip="{Binding VmTabTooltip}"/>
            </UniformGrid>
        </Border>

        <!-- ============================================ this computer -->
        <StackPanel Visibility="{Binding IsHostTab, Converter={StaticResource Visible}}">
            <TextBlock Text="{DynamicResource Str.Apply.Adapter}" Style="{StaticResource FieldLabel}" Margin="2,18,0,8"/>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChoiceRow}" GroupName="ApplyAdapter"
                                         IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"
                                         AutomationProperties.Name="{Binding Name}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{DynamicResource WarningBackgroundBrush}"
                                            Margin="10,0,0,0" Visibility="{Binding Badge, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding Badge}" Style="{StaticResource PillText}" Foreground="{DynamicResource WarningBrush}"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border CornerRadius="12" Padding="12,10" Margin="0,4,0,0" Background="{DynamicResource WarningBackgroundBrush}"
                    Visibility="{Binding ShowRiskWarning, Converter={StaticResource Visible}}">
                <DockPanel>
                    <c:Icon Data="{StaticResource Icon.Warning}" Width="16" Height="16" StrokeThickness="2" Margin="0,1,10,0"
                            VerticalAlignment="Top" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{DynamicResource Str.Apply.RiskWarning}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
                </DockPanel>
            </Border>
            <Border CornerRadius="12" Padding="12,10" Margin="0,4,0,0" Background="{DynamicResource AccentTintBrush}"
                    Visibility="{Binding ShowRj45Release, Converter={StaticResource Visible}}">
                <DockPanel>
                    <c:Icon Data="{StaticResource Icon.Rj45}" Width="16" Height="16" StrokeThickness="2" Margin="0,1,10,0"
                            VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{DynamicResource Str.Apply.Rj45ReleaseInfo}" FontSize="12.5" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ============================================ virtual machine -->
        <StackPanel Visibility="{Binding IsVmTab, Converter={StaticResource Visible}}">
            <TextBlock Text="{DynamicResource Str.Apply.VmRunningOnly}" FontSize="12" TextWrapping="Wrap" Margin="2,12,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <TextBlock Text="{DynamicResource Str.Apply.NoRunningVm}" FontSize="13" TextWrapping="Wrap" Margin="2,14,0,0"
                       Visibility="{Binding HasRunningVms, Converter={StaticResource Visible}, ConverterParameter=invert}"/>

            <StackPanel Visibility="{Binding HasRunningVms, Converter={StaticResource Visible}}">
                <TextBlock Text="{DynamicResource Str.Apply.Vm}" Style="{StaticResource FieldLabel}" Margin="2,14,0,8"/>
                <ItemsControl ItemsSource="{Binding Vms}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource SegmentItem}" GroupName="ApplyVm" Height="32" Padding="14,0" Margin="0,0,6,6"
                                         IsChecked="{Binding IsSelected}" Content="{Binding Name}" Background="{DynamicResource FieldBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{DynamicResource Str.Apply.VmAdapter}" Style="{StaticResource FieldLabel}" Margin="2,10,0,8"/>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding VmAdapters}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ChoiceRow}" GroupName="ApplyVmAdapter"
                                             IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}"
                                             AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="12.5" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{DynamicResource Str.Apply.VmMacInfo}" FontSize="12" TextWrapping="Wrap" Margin="2,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <DockPanel Margin="2,8,0,0">
                    <c:Icon Data="{StaticResource Icon.Globe}" Width="14" Height="14" StrokeThickness="2" Margin="0,1,8,0"
                            VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding VmPingNote}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DockPanel>
                <Border CornerRadius="12" Padding="12,10" Margin="0,10,0,0" Background="{DynamicResource WarningBackgroundBrush}"
                        Visibility="{Binding ShowVmNoSwitchWarning, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <c:Icon Data="{StaticResource Icon.Warning}" Width="16" Height="16" StrokeThickness="2" Margin="0,1,10,0"
                                VerticalAlignment="Top" Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="{DynamicResource Str.Apply.VmNoSwitch}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- rollback note -->
        <Border CornerRadius="12" Padding="12,10" Margin="0,10,0,0" Background="{DynamicResource FieldBrush}">
            <DockPanel>
                <c:Icon Data="{StaticResource Icon.Shield}" Width="16" Height="16" StrokeThickness="2" Margin="0,1,10,0"
                        VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Grid>
                    <TextBlock Text="{DynamicResource Str.Apply.Rollback}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding RollbackEnabled, Converter={StaticResource Visible}}"/>
                    <TextBlock Text="{DynamicResource Str.Apply.NoRollback}" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding RollbackEnabled, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
                </Grid>
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str.Common.Cancel}" Command="{Binding CancelCommand}"
                    IsCancel="True" Margin="0,0,10,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.Common.Apply}" Command="{Binding ConfirmCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
