<UserControl x:Class="Poni.Views.Dialogs.ExportSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Poni.Controls">
    <StackPanel>
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="13" FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentBrush}" Content="{Binding ToggleAllText}" Command="{Binding ToggleAllCommand}"
                    VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str.Transfer.SelectTitle}" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="Bold"/>
        </DockPanel>
        <TextBlock Text="{DynamicResource Str.Transfer.SelectHint}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,0,8" Cursor="Hand"
                                  AutomationProperties.Name="{Binding Name}" FocusVisualStyle="{StaticResource FocusRing}">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border x:Name="bd" CornerRadius="14" Padding="14,10" Background="{DynamicResource FieldBrush}"
                                            BorderThickness="2" BorderBrush="Transparent">
                                        <DockPanel>
                                            <Border x:Name="box" DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="6" Margin="0,0,12,0"
                                                    BorderThickness="1.5" BorderBrush="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                <c:Icon x:Name="tick" Data="{StaticResource Icon.Check}" Width="12" Height="12" StrokeThickness="3.4"
                                                        Foreground="White" Visibility="Collapsed"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Meta}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str.Common.Cancel}" Command="{Binding CancelCommand}"
                    IsCancel="True" Margin="0,0,10,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ExportText}" Command="{Binding ExportCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
