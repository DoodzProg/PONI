<UserControl x:Class="Poni.Views.Dialogs.VmCredentialsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Poni.Controls">
    <StackPanel>
        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource Str.Vm.CredHint}" FontSize="12.5" Margin="0,6,0,18" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <TextBlock Text="{DynamicResource Str.Vm.CredUser}" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="UserBox" Style="{StaticResource TextField}" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{DynamicResource Str.Vm.CredUser}"/>

        <TextBlock Text="{DynamicResource Str.Vm.CredPassword}" Style="{StaticResource FieldLabel}" Margin="2,14,0,6"/>
        <Border Height="38" CornerRadius="10" Background="{DynamicResource FieldBrush}" Padding="10,0">
            <PasswordBox x:Name="PasswordBox" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" FontSize="14"
                         Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                         AutomationProperties.Name="{DynamicResource Str.Vm.CredPassword}"/>
        </Border>

        <DockPanel Margin="2,12,0,0">
            <c:Icon Data="{StaticResource Icon.Shield}" Width="14" Height="14" StrokeThickness="2" Margin="0,1,8,0" VerticalAlignment="Top"
                    Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="{DynamicResource Str.Vm.CredPrivacy}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str.Common.Cancel}" Command="{Binding CancelCommand}"
                    IsCancel="True" Margin="0,0,10,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.Vm.CredConnect}" Command="{Binding ConnectCommand}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
