<UserControl x:Class="Poni.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Poni.Controls">
    <UserControl.Resources>

        <!-- ===================================================== adapter card -->
        <DataTemplate x:Key="AdapterCard">
            <ContentControl Style="{StaticResource Card}" Margin="0,0,16,16" Padding="16,15">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                    <Setter Property="Opacity" Value="0.62"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentTintBrush}" Margin="0,0,11,0">
                            <c:Icon Width="18" Height="18" Foreground="{DynamicResource AccentBrush}">
                                <c:Icon.Style>
                                    <Style TargetType="c:Icon" BasedOn="{StaticResource {x:Type c:Icon}}">
                                        <Setter Property="Data" Value="{StaticResource Icon.Rj45}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWiFi}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.Wifi}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource Icon.Monitor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </c:Icon.Style>
                            </c:Icon>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Description}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <Ellipse Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Connected">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="NoIpv4">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource GhostIconButton}" Tag="{StaticResource Icon.More}" c:Ui.OpensMenu="True"
                                AutomationProperties.Name="{DynamicResource Str.Common.MoreActions}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str.Machine.Configure}" Tag="{StaticResource Icon.Edit}"
                                              Command="{Binding Owner.ConfigureAdapterCommand}" CommandParameter="{Binding}"
                                              Visibility="{Binding CanConfigure, Converter={StaticResource Visible}}"/>
                                    <MenuItem Header="{DynamicResource Str.Machine.Dhcp}" Tag="{StaticResource Icon.Refresh}"
                                              Command="{Binding Owner.DhcpCommand}" CommandParameter="{Binding}"
                                              Visibility="{Binding CanSetDhcp, Converter={StaticResource Visible}}"/>
                                    <MenuItem Header="{DynamicResource Str.Machine.MakePrivate}" Tag="{StaticResource Icon.Shield}"
                                              Command="{Binding Owner.MakePrivateCommand}" CommandParameter="{Binding}"
                                              Visibility="{Binding CanMakePrivate, Converter={StaticResource Visible}}"/>
                                    <MenuItem Header="{DynamicResource Str.Machine.MakePublic}" Tag="{StaticResource Icon.Globe}"
                                              Command="{Binding Owner.MakePublicCommand}" CommandParameter="{Binding}"
                                              Visibility="{Binding CanMakePublic, Converter={StaticResource Visible}}"/>
                                    <MenuItem Header="{DynamicResource Str.Machine.NothingToDo}" IsEnabled="False"
                                              Visibility="{Binding CanConfigure, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </Grid.Resources>
                        <TextBlock Text="{DynamicResource Str.Field.Mode}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ModeText}"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Str.Field.Ip}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IpText}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Str.Field.GatewayShort}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GatewayText}"/>
                        <TextBlock Grid.Row="3" Text="{DynamicResource Str.Field.DnsShort}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DnsText}" ToolTip="{Binding DnsText}"/>
                        <TextBlock Grid.Row="4" Text="{DynamicResource Str.Field.Network}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CategoryText}" Margin="0"/>
                    </Grid>

                    <WrapPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource AccentTintBrush}" Margin="0,0,6,0"
                                Visibility="{Binding IsInternet, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Globe}" Width="12" Height="12" StrokeThickness="2.2" Margin="0,0,5,0"
                                        Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Str.Machine.InternetBadge}" Style="{StaticResource PillText}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="{DynamicResource WarningBackgroundBrush}"
                                Visibility="{Binding HasDuplicate, Converter={StaticResource Visible}}">
                            <TextBlock Text="{DynamicResource Str.Machine.DuplicateBadge}" Style="{StaticResource PillText}"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </ContentControl>
        </DataTemplate>

        <!-- ===================================================== pieces shared by both row layouts -->
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="Avatar">
            <Border Width="40" Height="40" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Avatar0BackgroundBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Avatar0Brush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AvatarIndex}" Value="1">
                                <Setter Property="Background" Value="{DynamicResource Avatar1BackgroundBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Avatar1Brush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AvatarIndex}" Value="2">
                                <Setter Property="Background" Value="{DynamicResource Avatar2BackgroundBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Avatar2Brush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AvatarIndex}" Value="3">
                                <Setter Property="Background" Value="{DynamicResource Avatar3BackgroundBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Avatar3Brush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RowActions">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SmallSecondaryButton}" Content="{DynamicResource Str.Common.Apply}"
                        Command="{Binding Owner.ApplyCommand}" CommandParameter="{Binding}"/>
                <Button Style="{StaticResource GhostIconButton}" Tag="{StaticResource Icon.More}" Margin="6,0,0,0" c:Ui.OpensMenu="True"
                        AutomationProperties.Name="{DynamicResource Str.Common.MoreActions}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Str.Common.Edit}" Tag="{StaticResource Icon.Edit}"
                                      Command="{Binding Owner.EditCommand}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{DynamicResource Str.Common.Duplicate}" Tag="{StaticResource Icon.Copy}"
                                      Command="{Binding Owner.DuplicateCommand}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{DynamicResource Str.Transfer.ExportOne}" Tag="{StaticResource Icon.Export}"
                                      Command="{Binding Owner.ExportOneCommand}" CommandParameter="{Binding}"/>
                            <!-- Custom order: keyboard alternative to dragging -->
                            <Separator Visibility="{Binding Owner.CanReorder, Converter={StaticResource Visible}}"/>
                            <MenuItem Header="{DynamicResource Str.Sort.MoveUp}" Tag="{StaticResource Icon.ArrowUp}"
                                      Visibility="{Binding Owner.CanReorder, Converter={StaticResource Visible}}"
                                      Command="{Binding Owner.MoveUpCommand}" CommandParameter="{Binding}"/>
                            <MenuItem Header="{DynamicResource Str.Sort.MoveDown}" Tag="{StaticResource Icon.ArrowDown}"
                                      Visibility="{Binding Owner.CanReorder, Converter={StaticResource Visible}}"
                                      Command="{Binding Owner.MoveDownCommand}" CommandParameter="{Binding}"/>
                            <Separator/>
                            <MenuItem Header="{DynamicResource Str.Common.Delete}" Tag="{StaticResource Icon.Trash}"
                                      Foreground="{DynamicResource DangerBrush}"
                                      Command="{Binding Owner.DeleteCommand}" CommandParameter="{Binding}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- "Applied · Ethernet": green = adapter connected (in use), grey = adapter unplugged. -->
        <DataTemplate x:Key="ActiveBadge">
            <Border Margin="8,0,0,0" Padding="6,2,8,2" ToolTip="{Binding ActiveTooltip}"
                    Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                        <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActiveConnected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Check}" Width="11" Height="11" StrokeThickness="3" Margin="0,0,4,0"
                            Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                    <TextBlock Text="{Binding ActiveText}" FontSize="11.5" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Custom order: 6-dot handle in the row's left margin (take it to drag the row),
             and the blue line showing where a dragged row would land. Drag logic: ProfilesPage.xaml.cs. -->
        <DataTemplate x:Key="RowReorder">
            <Grid>
                <Border x:Name="grip" Width="16" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeAll"
                        Visibility="{Binding Owner.CanReorder, Converter={StaticResource Visible}}"
                        ToolTip="{DynamicResource Str.Sort.DragHint}"
                        PreviewMouseLeftButtonDown="OnGripDown" PreviewMouseMove="OnGripMove" PreviewMouseLeftButtonUp="OnGripUp">
                    <c:Icon x:Name="dots" Data="{StaticResource Icon.Grip}" Width="14" Height="14" StrokeThickness="3.2"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"
                            Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8"/>
                </Border>
                <Border x:Name="above" Height="2" VerticalAlignment="Top" Margin="10,-1,10,0" CornerRadius="1"
                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                <Border x:Name="below" Height="2" VerticalAlignment="Bottom" Margin="10,0,10,-1" CornerRadius="1"
                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="grip" Property="IsMouseOver" Value="True">
                    <Setter TargetName="dots" Property="Opacity" Value="1"/>
                    <Setter TargetName="dots" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding DropHint}" Value="Above">
                    <Setter TargetName="above" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DropHint}" Value="Below">
                    <Setter TargetName="below" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===================================================== simple row -->
        <DataTemplate x:Key="SimpleRow">
            <Border Style="{StaticResource RowBorder}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Owner.ApplyCommand}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                <Grid Margin="16,12,14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}"/>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <!-- The badge always stays visible: a long name is cut with "..." before it. -->
                        <DockPanel HorizontalAlignment="Left">
                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource ActiveBadge}"/>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Meta}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding Meta}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TargetText}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetText}"/>
                        <TextBlock Text="{Binding WhenText}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding HasWhen, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                    <ContentPresenter Grid.Column="3" Content="{Binding}" ContentTemplate="{StaticResource RowActions}" VerticalAlignment="Center"/>
                </Grid>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowReorder}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===================================================== detailed row -->
        <DataTemplate x:Key="DetailedRow">
            <Border Style="{StaticResource RowBorder}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Owner.ApplyCommand}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                <Grid Margin="16,10,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="128"/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </Grid.Resources>
                    <!-- Name first, badge below: side by side, the badge squeezed the name to "..." in this narrow column. -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0" ToolTip="{Binding Name}"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ActiveBadge}" HorizontalAlignment="Left"
                                          Margin="-8,4,0,0" Visibility="{Binding IsActive, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding IpText}"/>
                    <TextBlock Grid.Column="2" Text="{Binding MaskText}"/>
                    <TextBlock Grid.Column="3" Text="{Binding GatewayText}"/>
                    <TextBlock Grid.Column="4" Text="{Binding DnsText}" ToolTip="{Binding DnsText}"/>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding TargetText}" ToolTip="{Binding TargetText}" Margin="0"/>
                        <TextBlock Text="{Binding WhenText}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding HasWhen, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                    <ContentPresenter Grid.Column="6" Content="{Binding}" ContentTemplate="{StaticResource RowActions}" VerticalAlignment="Center"/>
                </Grid>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowReorder}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,36,40,90">

            <!-- ============================================ header -->
            <DockPanel Margin="0,0,0,26">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Border Height="36" CornerRadius="18" Background="{DynamicResource FieldBrush}" Padding="14,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Search}" Width="15" Height="15" StrokeThickness="2.2"
                                    Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <Grid>
                                <TextBlock Text="{DynamicResource Str.Profiles.Search}" FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"
                                           Visibility="{Binding Search, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
                                <TextBox x:Name="SearchBox" ToolTip="Ctrl+F"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="170" FontSize="13.5"
                                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                         AutomationProperties.Name="{DynamicResource Str.Profiles.Search}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewProfileCommand}" ToolTip="Ctrl+N"
                            AutomationProperties.Name="{DynamicResource Str.Profiles.New}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource Icon.Plus}" Width="15" Height="15" StrokeThickness="2.4" Foreground="White" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource Str.Profiles.New}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Profiles.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{DynamicResource Str.Profiles.Subtitle}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>

            <!-- ============================================ this machine -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource LinkButton}" Content="{Binding VirtualToggleText}" Command="{Binding ToggleVirtualCommand}"
                            Margin="0,0,10,0" Visibility="{Binding HasVirtualAdapters, Converter={StaticResource Visible}}"/>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="{Binding RefreshText}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="13" Height="13" Margin="0,0,6,0">
                                <c:Icon Data="{StaticResource Icon.Refresh}" Width="13" Height="13" StrokeThickness="2.2"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Visibility="{Binding IsRefreshing, Converter={StaticResource Visible}, ConverterParameter=invert}"/>
                                <c:Icon Style="{StaticResource Spinner}" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}"
                                        Visibility="{Binding IsRefreshing, Converter={StaticResource Visible}}"/>
                            </Grid>
                            <TextBlock Text="{Binding RefreshText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{DynamicResource Str.Machine.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Adapters}" ItemTemplate="{StaticResource AdapterCard}" Margin="0,0,-16,14" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ============================================ my profiles -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Style="{StaticResource SegmentedHost}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentItem}" GroupName="View" Height="26" Padding="12,0" FontSize="12.5"
                                         Content="{DynamicResource Str.Profiles.SimpleView}" IsChecked="{Binding SimpleView}"/>
                            <RadioButton Style="{StaticResource SegmentItem}" GroupName="View" Height="26" Padding="12,0" FontSize="12.5"
                                         Content="{DynamicResource Str.Profiles.DetailedView}" IsChecked="{Binding DetailedView}"/>
                        </StackPanel>
                    </Border>
                    <!-- Sort: funnel menu, current choice ticked -->
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Filter}" Margin="0,0,8,0" c:Ui.OpensMenu="True"
                            ToolTip="{Binding SortTooltip}" AutomationProperties.Name="{Binding SortTooltip}">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding SortChoices}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Label}"/>
                                        <Setter Property="Command" Value="{Binding Command}"/>
                                        <Setter Property="Tag" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Tag" Value="{StaticResource Icon.Check}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Import}" Command="{Binding ImportCommand}"
                            ToolTip="{DynamicResource Str.Transfer.Import}" AutomationProperties.Name="{DynamicResource Str.Transfer.Import}"/>
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Export}" Margin="8,0,0,0" c:Ui.OpensMenu="True"
                            ToolTip="{DynamicResource Str.Transfer.Export}" AutomationProperties.Name="{DynamicResource Str.Transfer.Export}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource Str.Transfer.ExportAll}" Tag="{StaticResource Icon.Export}"
                                          Command="{Binding ExportAllCommand}"/>
                                <MenuItem Header="{DynamicResource Str.Transfer.ExportSelection}" Tag="{StaticResource Icon.Check}"
                                          Command="{Binding ExportSelectionCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str.Profiles.Mine}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ProfileCount}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>

            <!-- list -->
            <ContentControl Style="{StaticResource GroupCard}" Visibility="{Binding HasProfiles, Converter={StaticResource Visible}}">
                <StackPanel>
                    <!-- column headers (detailed view) -->
                    <Grid Margin="16,11,14,9" Visibility="{Binding DetailedView, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="128"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Style>
                        </Grid.Resources>
                        <TextBlock Text="{DynamicResource Str.Field.Name}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str.Field.Ip}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Str.Field.MaskShort}"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Str.Field.GatewayShort}"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Str.Field.DnsShort}"/>
                        <TextBlock Grid.Column="5" Text="{DynamicResource Str.Profiles.LastTarget}"/>
                    </Grid>
                    <Border Style="{StaticResource GroupDivider}" Visibility="{Binding DetailedView, Converter={StaticResource Visible}}"/>

                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AllowDrop="True"
                                  DragOver="OnRowsDragOver" DragLeave="OnRowsDragLeave" Drop="OnRowsDrop">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemTemplate" Value="{StaticResource SimpleRow}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DetailedView}" Value="True">
                                        <Setter Property="ItemTemplate" Value="{StaticResource DetailedRow}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <TextBlock Margin="18,16" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Str.Profiles.NoMatch}"
                               Visibility="{Binding NoSearchResult, Converter={StaticResource Visible}}"/>
                </StackPanel>
            </ContentControl>

            <!-- empty state -->
            <ContentControl Style="{StaticResource Card}" Padding="28,26" MaxWidth="560" HorizontalAlignment="Left"
                            Visibility="{Binding HasProfiles, Converter={StaticResource Visible}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AccentTintBrush}" VerticalAlignment="Top">
                        <c:Icon Data="{StaticResource Icon.Profiles}" Width="26" Height="26" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel Margin="18,2,0,0" MaxWidth="420">
                        <TextBlock Text="{DynamicResource Str.Profiles.EmptyTitle}" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource Str.Profiles.EmptyText}" Style="{StaticResource RowCaption}" FontSize="13.5" Margin="0,6,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SmallPrimaryButton}" Content="{DynamicResource Str.Profiles.New}" Command="{Binding NewProfileCommand}"/>
                            <Button Style="{StaticResource SmallSecondaryButton}" Content="{DynamicResource Str.Transfer.Import}" Command="{Binding ImportCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
