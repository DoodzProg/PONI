<!--
  PONI design system - DARK palette. Same keys as Colors.Light.xaml (keep both in sync).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#232325"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#23393B"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEAEB2"/>

    <!-- Interaction states -->
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#636366"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#48484A"/>
    <SolidColorBrush x:Key="PressOverlayBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="CaptionForegroundBrush" Color="#AEAEB2"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#14FFFFFF"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#32D74B"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#2632D74B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB340"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#26FF9F0A"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6961"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#26FF453A"/>

    <!-- Profile avatars -->
    <SolidColorBrush x:Key="Avatar0Brush" Color="#6EA8FF"/>
    <SolidColorBrush x:Key="Avatar0BackgroundBrush" Color="#2E6EA8FF"/>
    <SolidColorBrush x:Key="Avatar1Brush" Color="#FF9F5A"/>
    <SolidColorBrush x:Key="Avatar1BackgroundBrush" Color="#2EFF9F5A"/>
    <SolidColorBrush x:Key="Avatar2Brush" Color="#4CD787"/>
    <SolidColorBrush x:Key="Avatar2BackgroundBrush" Color="#2E4CD787"/>
    <SolidColorBrush x:Key="Avatar3Brush" Color="#D1A07A"/>
    <SolidColorBrush x:Key="Avatar3BackgroundBrush" Color="#2ED1A07A"/>

    <!-- Dialogs / menus / toasts -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000"/>
    <SolidColorBrush x:Key="DialogBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="MenuBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#48484A"/>
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A"/>
    <DropShadowEffect x:Key="DialogShadow" Color="#000000" BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.5"/>

    <!-- Shadows -->
    <Color x:Key="ShadowColor">#000000</Color>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.32"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.4"/>

</ResourceDictionary>
