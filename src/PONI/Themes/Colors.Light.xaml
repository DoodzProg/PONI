<!--
  PONI design system - LIGHT palette ("Apple" direction, see docs/2026-09-28_DECISIONS-v2.0.md §6).
  Colors.Dark.xaml MUST define exactly the same keys. Always reference these with DynamicResource:
  ThemeService swaps the whole dictionary at runtime. Accent brushes are set by ThemeService.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FBFBFD"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F2F2F5"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#EDEDF2"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#EAEAEF"/>
    <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#E2F2F3"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#12000000"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73"/>

    <!-- Interaction states -->
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#11000000"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#D1D1D6"/>
    <SolidColorBrush x:Key="PressOverlayBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0C000000"/>
    <SolidColorBrush x:Key="CaptionForegroundBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#0F000000"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7F37"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#E2F4E7"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#8A4B00"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF0DB"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9"/>

    <!-- Profile avatars: the four cable colours of the PONI logo (text on tinted background) -->
    <SolidColorBrush x:Key="Avatar0Brush" Color="#2F6FD6"/>
    <SolidColorBrush x:Key="Avatar0BackgroundBrush" Color="#E6EEFB"/>
    <SolidColorBrush x:Key="Avatar1Brush" Color="#C05A17"/>
    <SolidColorBrush x:Key="Avatar1BackgroundBrush" Color="#FBEBDF"/>
    <SolidColorBrush x:Key="Avatar2Brush" Color="#1F8A50"/>
    <SolidColorBrush x:Key="Avatar2BackgroundBrush" Color="#E1F3E8"/>
    <SolidColorBrush x:Key="Avatar3Brush" Color="#7F5234"/>
    <SolidColorBrush x:Key="Avatar3BackgroundBrush" Color="#F1E8E1"/>

    <!-- Dialogs / menus / toasts -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#4D1C1C1E"/>
    <SolidColorBrush x:Key="DialogBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#EDEDF2"/>
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
    <DropShadowEffect x:Key="DialogShadow" Color="#000000" BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.22"/>

    <!-- Shadows (applied on a background layer, never on text: keeps ClearType) -->
    <Color x:Key="ShadowColor">#000000</Color>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.07"/>
    <DropShadowEffect x:Key="SmallShadow" Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.14"/>

</ResourceDictionary>
